# Local model and tool locations. Replace these placeholders for your machine.
MODEL_ROOT=/path/to/models
LLAMA_CPP_ROOT=/path/to/llama.cpp
BENCH_DATA_ROOT=/path/to/gb10-llm-benchmark-data

# Optional executable overrides (LLMBENCH_* is the backend settings prefix).
LLMBENCH_LLAMA_BENCH=llama-bench
LLMBENCH_LLAMA_SERVER=llama-server
LLMBENCH_LLAMA_SERVER_URL=
LLMBENCH_API_BASE=
LLMBENCH_SERVER_HOST=
LLMBENCH_MANAGED_SERVER_PORT=
LLMBENCH_CORS_ORIGINS=
